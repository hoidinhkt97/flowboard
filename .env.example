# Required in production

# Generate: openssl rand -hex 32
FLOWBOARD_JWT_SECRET=CHANGE_ME

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FLOWBOARD_ENCRYPTION_KEY=CHANGE_ME

# Database
POSTGRES_PASSWORD=CHANGE_ME

# MinIO (default S3 backend)
MINIO_ROOT_USER=flowboard
MINIO_ROOT_PASSWORD=CHANGE_ME

# Optional: use AWS S3 or Cloudflare R2 instead of MinIO
# FLOWBOARD_S3_ENDPOINT=https://s3.amazonaws.com
# FLOWBOARD_S3_BUCKET=my-bucket
# FLOWBOARD_S3_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
# FLOWBOARD_S3_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# FLOWBOARD_S3_REGION=us-east-1
